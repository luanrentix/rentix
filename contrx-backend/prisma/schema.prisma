generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SYSTEM_OWNER @map("DONO_SISTEMA")
  OWNER   @map("PROPRIETARIO")
  ADMIN   @map("ADMINISTRADOR")
  MANAGER @map("GERENTE")
  USER

  @@map("papel_usuario")
}

enum SubscriptionStatus {
  TRIAL     @map("TESTE")
  ACTIVE    @map("ATIVO")
  EXPIRED   @map("VENCIDO")
  SUSPENDED @map("SUSPENSO")
  CANCELED  @map("CANCELADO")

  @@map("status_assinatura_empresa")
}

enum PersonType {
  INDIVIDUAL @map("PESSOA_FISICA")
  COMPANY    @map("PESSOA_JURIDICA")

  @@map("tipo_pessoa")
}

enum PersonStatus {
  ACTIVE   @map("ATIVO")
  INACTIVE @map("INATIVO")

  @@map("status_pessoa")
}

model Company {
  id          String  @id @default(uuid())
  tradeName   String  @map("nome_fantasia")
  companyName String? @map("razao_social")
  document    String? @map("documento")
  phone       String? @map("telefone")
  email       String?
  isActive    Boolean @default(true) @map("ativo")
  subscriptionStatus SubscriptionStatus @default(TRIAL) @map("status_assinatura")
  trialStartsAt      DateTime?          @map("teste_inicia_em")
  trialEndsAt        DateTime?          @map("teste_termina_em")
  trialExtendedUntil DateTime?          @map("teste_prorrogado_ate")
  subscriptionEndsAt DateTime?          @map("assinatura_termina_em")

  createdAt DateTime @default(now()) @map("criado_em")
  updatedAt DateTime @updatedAt @map("atualizado_em")

  users              User[]
  people             Person[]
  properties         Property[]
  contracts          Contract[]
  receivableAccounts ContaReceber[]
  payableAccounts    ContaPagar[]
  scheduleItems       ScheduleItem[]
  propertyMovements   PropertyMovement[]
  settings           AppSettings?
  commercialHistories CommercialHistory[]
  bankAccounts       BankAccount[]
  supportTickets     SupportTicket[]
  sharedBankStatements SharedBankStatement[]
  systemFiles        SystemFile[]
  errorLogs          SystemErrorLog[]

  @@map("empresas")
}

model CommercialHistory {
  id        String @id @default(uuid())
  companyId String @map("empresa_id")
  userId    String? @map("usuario_id")

  action      String @map("acao")
  description String @map("descricao")
  metadata    Json?  @map("metadados")

  createdAt DateTime @default(now()) @map("criado_em")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([createdAt])
  @@map("historico_comercial")
}

model AppSettings {
  id        String @id @default(uuid())
  companyId String @unique @map("empresa_id")

  userSettings    Json? @map("configuracoes_usuario")
  companySettings Json? @map("configuracoes_empresa")
  themeSettings   Json? @map("configuracoes_tema")
  printTemplates  Json? @map("modelos_impressao")

  createdAt DateTime @default(now()) @map("criado_em")
  updatedAt DateTime @updatedAt @map("atualizado_em")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("configuracoes_app")
}

model User {
  id           String @id @default(uuid())
  companyId    String @map("empresa_id")
  name         String @map("nome")
  email        String @unique
  passwordHash String @map("senha_hash")

  role     UserRole @default(USER) @map("papel")
  isActive Boolean  @default(true) @map("ativo")
  permissions Json? @map("permissoes")
  activeSessionId String? @map("sessao_ativa_id")
  passwordResetTokenHash String? @map("token_recuperacao_senha_hash")
  passwordResetExpiresAt DateTime? @map("token_recuperacao_senha_expira_em")
  lastLoginAt            DateTime? @map("ultimo_login_em")

  createdAt DateTime @default(now()) @map("criado_em")
  updatedAt DateTime @updatedAt @map("atualizado_em")

  company Company @relation(fields: [companyId], references: [id])
  supportTickets SupportTicket[]

  @@map("usuarios")
}

model Person {
  id        String @id @default(uuid())
  companyId String @map("empresa_id")

  type   PersonType   @map("tipo")
  status PersonStatus @default(ACTIVE) @map("status")

  name     String @map("nome")
  document String @map("documento")

  stateRegistration String? @map("inscricao_estadual")
  identityNumber    String? @map("rg")

  email String?
  phone String? @map("telefone")

  isTenant Boolean @default(true) @map("inquilino")

  zipCode String? @map("cep")
  city    String? @map("cidade")
  state   String? @map("estado")
  address String? @map("endereco")
  photo   String? @map("foto")

  createdAt DateTime @default(now()) @map("criado_em")
  updatedAt DateTime @updatedAt @map("atualizado_em")

  company            Company        @relation(fields: [companyId], references: [id])
  properties         Property[]
  tenantContracts    Contract[]     @relation("ContractTenant")
  receivableAccounts ContaReceber[]
  payableAccounts    ContaPagar[]
  scheduleItems       ScheduleItem[]

  @@index([companyId])
  @@index([document])
  @@map("pessoas")
}

model Property {
  id        String  @id @default(uuid())
  companyId String  @map("empresa_id")
  ownerId   String? @map("proprietario_id")

  title       String   @map("titulo")
  code        String?  @map("codigo")
  type        String?  @map("tipo")
  purpose     String?  @map("finalidade")
  assetCategory String? @map("categoria_ativo")
  brand       String?  @map("marca")
  model       String?  @map("modelo")
  serialNumber String? @map("numero_serie")
  licensePlate String? @map("placa")
  manufactureYear Int? @map("ano_fabricacao")
  condition   String? @map("condicao")
  patrimonyCode String? @map("codigo_patrimonial")
  rentalValue Decimal? @map("valor_aluguel") @db.Decimal(10, 2)
  managementMode String @default("OWNED") @map("modo_gestao")
  administrationFeePercentage Decimal? @map("taxa_administracao_percentual") @db.Decimal(5, 2)
  ownerPayoutDay Int? @map("dia_repasse_proprietario")
  autoCreateOwnerPayable Boolean @default(true) @map("gerar_repasse_proprietario")

  zipCode    String? @map("cep")
  city       String? @map("cidade")
  state      String? @map("estado")
  address    String? @map("endereco")
  district   String? @map("bairro")
  number     String? @map("numero")
  complement String? @map("complemento")

  bedrooms  Int? @map("quartos")
  bathrooms Int? @map("banheiros")
  garages   Int? @map("garagens")

  description String? @map("descricao")
  photos      String? @map("fotos")

  isActive Boolean @default(true) @map("ativo")

  createdAt DateTime @default(now()) @map("criado_em")
  updatedAt DateTime @updatedAt @map("atualizado_em")

  company   Company    @relation(fields: [companyId], references: [id])
  owner     Person?    @relation(fields: [ownerId], references: [id])
  contracts Contract[]
  movements PropertyMovement[]
  payableAccounts ContaPagar[]
  scheduleItems ScheduleItem[]

  @@index([companyId])
  @@index([ownerId])
  @@map("imoveis")
}

model PropertyMovement {
  id        String @id @default(uuid())
  companyId String @map("empresa_id")
  propertyId String @map("imovel_id")

  propertyName String @map("nome_imovel")
  type         String @map("tipo")
  description  String @map("descricao")

  createdAt DateTime @default(now()) @map("criado_em")
  updatedAt DateTime @updatedAt @map("atualizado_em")

  company  Company  @relation(fields: [companyId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])

  @@index([companyId])
  @@index([propertyId])
  @@index([createdAt])
  @@map("movimentacoes_imoveis")
}

enum ContractStatus {
  ACTIVE   @map("ATIVO")
  INACTIVE @map("INATIVO")
  CANCELED @map("CANCELADO")
  FINISHED @map("FINALIZADO")
  DELETED  @map("EXCLUIDO")

  @@map("status_contrato")
}

enum ContractStatusReasonType {
  CANCELED @map("CANCELADO")
  DELETED  @map("EXCLUIDO")

  @@map("tipo_motivo_status_contrato")
}

model Contract {
  id         String @id @default(uuid())
  companyId  String @map("empresa_id")
  propertyId String @map("imovel_id")
  tenantId   String @map("inquilino_id")

  propertyName String? @map("nome_imovel")
  tenantName   String? @map("nome_inquilino")

  startDate DateTime @map("data_inicio")
  endDate   DateTime @map("data_fim")
  rentValue Decimal  @map("valor_aluguel") @db.Decimal(10, 2)

  status ContractStatus @default(ACTIVE) @map("status")

  deletedAt        DateTime?                 @map("excluido_em")
  statusReason     String?                   @map("motivo_status")
  statusReasonType ContractStatusReasonType? @map("tipo_motivo_status")
  statusReasonAt   DateTime?                 @map("motivo_status_em")

  isTemporaryRental Boolean @default(false) @map("locacao_temporaria")
  checkInTime       String? @map("horario_entrada")
  checkOutTime      String? @map("horario_saida")

  renewedAt      DateTime? @map("renovado_em")
  renewalHistory Json?     @map("historico_renovacoes")

  finishedAt   DateTime? @map("finalizado_em")
  finishReason String?   @map("motivo_finalizacao")
  signedContractPdf String? @map("contrato_assinado_pdf")

  createdAt DateTime @default(now()) @map("criado_em")
  updatedAt DateTime @updatedAt @map("atualizado_em")

  company            Company             @relation(fields: [companyId], references: [id])
  property           Property            @relation(fields: [propertyId], references: [id])
  tenant             Person              @relation("ContractTenant", fields: [tenantId], references: [id])
  receivableAccounts ContaReceber[]
  signatures         ContractSignature[]

  @@index([companyId])
  @@index([propertyId])
  @@index([tenantId])
  @@index([status])
  @@map("contratos")
}

enum FinancialAccountStatus {
  PENDING @map("PENDENTE")
  PAID    @map("PAGO")

  @@map("status_conta_financeira")
}

enum PaymentMethod {
  CASH          @map("DINHEIRO")
  PIX           @map("PIX")
  CREDIT_CARD   @map("CARTAO_CREDITO")
  DEBIT_CARD    @map("CARTAO_DEBITO")
  BANK_SLIP     @map("BOLETO")
  BANK_TRANSFER @map("TRANSFERENCIA")
  OTHER         @map("OUTRO")

  @@map("forma_pagamento")
}

model ContaReceber {
  id         String  @id @default(uuid())
  companyId  String  @map("empresa_id")
  contractId String? @map("contrato_id")
  tenantId   String? @map("inquilino_id")

  propertyName String @map("imovel")
  tenantName   String @map("inquilino")

  issueDate DateTime?              @map("data_lancamento")
  dueDate   DateTime               @map("data_vencimento")
  amount    Decimal                @map("valor") @db.Decimal(10, 2)
  status    FinancialAccountStatus @default(PENDING) @map("status")
  manual    Boolean                @default(true) @map("manual")

  installmentNumber  Int?    @map("numero_parcela")
  installmentTotal   Int?    @map("total_parcelas")
  installmentGroupId String? @map("grupo_parcelamento_id")
  isDownPayment      Boolean @default(false) @map("entrada")

  createdAt DateTime @default(now()) @map("criado_em")
  updatedAt DateTime @updatedAt @map("atualizado_em")

  company  Company             @relation(fields: [companyId], references: [id])
  contract Contract?           @relation(fields: [contractId], references: [id])
  tenant   Person?             @relation(fields: [tenantId], references: [id])
  payments PagamentoRecebido[]

  @@index([companyId])
  @@index([contractId])
  @@index([tenantId])
  @@index([status])
  @@index([dueDate])
  @@map("contas_receber")
}

model PagamentoRecebido {
  id       String @id @default(uuid())
  chargeId String @map("conta_receber_id")

  paidAt       DateTime      @map("pago_em")
  method       PaymentMethod @map("forma_pagamento")
  paymentItems Json?         @map("itens_pagamento")
  interest     Decimal       @default(0) @map("juros") @db.Decimal(10, 2)
  discount     Decimal       @default(0) @map("desconto") @db.Decimal(10, 2)
  amountPaid   Decimal       @map("valor_pago") @db.Decimal(10, 2)
  note         String?       @map("observacao")

  createdAt DateTime @default(now()) @map("criado_em")
  updatedAt DateTime @updatedAt @map("atualizado_em")

  charge ContaReceber @relation(fields: [chargeId], references: [id])

  @@index([chargeId])
  @@map("pagamentos_recebidos")
}

model ContaPagar {
  id         String  @id @default(uuid())
  companyId  String  @map("empresa_id")
  personId   String? @map("pessoa_id")
  propertyId String? @map("imovel_id")
  personName String? @map("pessoa")

  description String                 @map("descricao")
  category    String?                @map("categoria")
  note        String?                @map("observacao")
  amount      Decimal                @map("valor") @db.Decimal(10, 2)
  issueDate   DateTime?              @map("data_lancamento")
  dueDate     DateTime               @map("data_vencimento")
  status      FinancialAccountStatus @default(PENDING) @map("status")
  manual      Boolean                @default(true) @map("manual")

  installmentNumber  Int?    @map("numero_parcela")
  installmentTotal   Int?    @map("total_parcelas")
  installmentGroupId String? @map("grupo_parcelamento_id")

  createdAt DateTime @default(now()) @map("criado_em")
  updatedAt DateTime @updatedAt @map("atualizado_em")

  company  Company              @relation(fields: [companyId], references: [id])
  person   Person?              @relation(fields: [personId], references: [id])
  property Property?            @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  payments PagamentoRealizado[]

  @@index([companyId])
  @@index([personId])
  @@index([propertyId])
  @@index([status])
  @@index([dueDate])
  @@map("contas_pagar")
}

model PagamentoRealizado {
  id        String @id @default(uuid())
  expenseId String @map("conta_pagar_id")

  paidAt       DateTime      @map("pago_em")
  method       PaymentMethod @map("forma_pagamento")
  paymentItems Json?         @map("itens_pagamento")
  interest     Decimal       @default(0) @map("juros") @db.Decimal(10, 2)
  discount     Decimal       @default(0) @map("desconto") @db.Decimal(10, 2)
  amountPaid   Decimal       @map("valor_pago") @db.Decimal(10, 2)
  note         String?       @map("observacao")

  createdAt DateTime @default(now()) @map("criado_em")
  updatedAt DateTime @updatedAt @map("atualizado_em")

  expense ContaPagar @relation(fields: [expenseId], references: [id])

  @@index([expenseId])
  @@map("pagamentos_realizados")
}

model ScheduleItem {
  id        String @id @default(uuid())
  companyId String @map("empresa_id")

  title           String @map("titulo")
  personId        String? @map("pessoa_id")
  propertyId      String? @map("imovel_id")
  customerName    String @default("") @map("cliente")
  propertyName    String @default("") @map("imovel")
  date            DateTime @map("data")
  time            String @map("horario")
  type            String @map("tipo")
  status          String @default("scheduled") @map("status")
  priority        String @default("medium") @map("prioridade")
  responsibleName String @map("responsavel")
  reminder        String @map("lembrete")
  notes           String? @map("observacoes")

  createdAt DateTime @default(now()) @map("criado_em")
  updatedAt DateTime @updatedAt @map("atualizado_em")

  company  Company   @relation(fields: [companyId], references: [id])
  person   Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([date])
  @@index([personId])
  @@index([propertyId])
  @@map("agenda_itens")
}

enum ContractSignatureStatus {
  PENDING
  SIGNED
}

enum SignerRole {
  LANDLORD
  TENANT
  GUARANTOR
  WITNESS
}

model ContractSignature {
  id           String                  @id @default(uuid())
  contractId   String                  @map("contrato_id")
  name         String                  @map("nome")
  email        String                  @map("email")
  role         SignerRole              @default(TENANT) @map("papel")
  status       ContractSignatureStatus @default(PENDING) @map("status")
  token        String                  @unique @map("token_acesso")
  signedAt     DateTime?               @map("assinado_em")
  ipAddress    String?                 @map("endereco_ip")
  userAgent    String?                 @map("agente_usuario")
  documentHash String?                 @map("hash_documento")

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("assinaturas_contrato")
}

enum BankAccountType {
  CHECKING
  SAVINGS
  INVESTMENT
  CASH
}

enum BankTransactionType {
  INFLOW
  OUTFLOW
}

enum BankTransactionStatus {
  PENDING
  CONFIRMED
}

model BankAccount {
  id             String          @id @default(uuid())
  companyId      String          @map("empresa_id")
  name           String          @map("nome")
  type           BankAccountType @default(CHECKING) @map("tipo")
  agency         String?         @map("agencia")
  accountNumber  String?         @map("numero_conta")
  bankCode       String?         @map("codigo_banco")
  bankName       String?         @map("nome_banco")
  initialBalance Decimal         @default(0) @map("saldo_inicial") @db.Decimal(10, 2)
  currentBalance Decimal         @default(0) @map("saldo_atual") @db.Decimal(10, 2)
  limit          Decimal         @default(0) @map("limite") @db.Decimal(10, 2)
  currency       String          @default("BRL") @map("moeda")
  active         Boolean         @default(true) @map("ativo")
  deletedAt      DateTime?       @map("deletado_em")
  
  createdAt      DateTime        @default(now()) @map("criado_em")
  updatedAt      DateTime        @updatedAt @map("atualizado_em")

  company        Company           @relation(fields: [companyId], references: [id])
  transactions   BankTransaction[]

  @@index([companyId])
  @@map("contas_bancarias")
}

model BankTransaction {
  id            String                @id @default(uuid())
  bankAccountId String                @map("conta_bancaria_id")
  type          BankTransactionType   @map("tipo")
  status        BankTransactionStatus @default(PENDING) @map("status")
  amount        Decimal               @map("valor") @db.Decimal(10, 2)
  fee           Decimal               @default(0) @map("taxa") @db.Decimal(10, 2)
  description   String                @map("descricao")
  competenceDate DateTime             @map("data_competencia")
  paymentDate   DateTime?             @map("data_pagamento")
  category      String?               @map("categoria")
  referenceType String?               @map("tipo_referencia")
  referenceId   String?               @map("id_referencia")
  transferGroupId String?             @map("grupo_transferencia_id")
  
  createdAt     DateTime              @default(now()) @map("criado_em")
  updatedAt     DateTime              @updatedAt @map("atualizado_em")

  bankAccount   BankAccount           @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@index([bankAccountId])
  @@index([competenceDate])
  @@map("movimentacoes_bancarias")
}

model SupportTicket {
  id        String   @id @default(uuid())
  userId    String   @map("usuario_id")
  companyId String   @map("empresa_id")
  subject   String   @map("assunto")
  message   String   @map("mensagem")
  response  String?  @map("resposta")
  status    String   @default("ABERTO") @map("status") // ABERTO, RESPONDIDO, FECHADO
  createdAt DateTime @default(now()) @map("criado_em")
  updatedAt DateTime @updatedAt @map("atualizado_em")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@map("chamados_suporte")
}

model SharedBankStatement {
  id                String    @id @default(uuid())
  companyId         String    @map("empresa_id")
  bankAccountId     String?   @map("conta_bancaria_id")
  documentType      String?   @default("EXTRATO_BANCARIO") @map("tipo_documento")
  tenantId          String?   @map("cliente_id")
  filterStartDate   String?   @map("data_inicio")
  filterEndDate     String?   @map("data_fim")
  filterType        String?   @map("tipo")
  filterDue         String?   @map("filtro_vencimento")
  filterStatus      String?   @map("status")
  filterCategory    String?   @map("categoria")
  filterDescription String?   @map("descricao")
  expiresAt         DateTime  @map("expira_em")
  createdAt         DateTime  @default(now()) @map("criado_em")

  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("impressos_compartilhados")
}

enum SystemFileType {
  IMAGE
  PDF
  DOCUMENT
  OTHER
}

enum SystemFileEntity {
  PROPERTY
  PERSON
  CONTRACT
  COMPANY
  OTHER
}

model SystemFile {
  id         String           @id @default(uuid())
  companyId  String           @map("empresa_id")
  entityType SystemFileEntity @map("tipo_entidade")
  entityId   String           @map("entidade_id")
  url        String           @map("url")
  type       SystemFileType   @map("tipo_arquivo")
  size       Int?             @map("tamanho")
  originalName String?        @map("nome_original")

  createdAt  DateTime         @default(now()) @map("criado_em")
  updatedAt  DateTime         @updatedAt @map("atualizado_em")

  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([entityType, entityId])
  @@map("arquivos_sistema")
}

model SystemErrorLog {
  id             String   @id @default(uuid())
  companyId      String?  @map("empresa_id")
  level          String   @default("ERROR") @map("nivel")
  message        String   @map("mensagem")
  stack          String?  @map("stack_trace")
  route          String?  @map("rota")
  method         String?  @map("metodo")
  statusCode     Int?     @map("status_code")
  userEmail      String?  @map("email_usuario")
  requestPayload String?  @map("payload_requisicao")
  userAgent      String?  @map("user_agent")
  ipAddress      String?  @map("ip")
  createdAt      DateTime @default(now()) @map("criado_em")

  company        Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([createdAt])
  @@map("error")
}
